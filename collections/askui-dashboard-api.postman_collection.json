          "id": "60fcfa15-5378-4ec6-a9ae-eca9fe7d29a8",
          "name": "Aggregate Usage Events",
          "request": {
            "name": "Aggregate Usage Events",
            "description": {
              "content": "List usage events sorted chronologically by timestamp. Events can be filtered by workspace, user, or access token.\n\nFilter combinations:\n- Multiple filters (e.g. workspace_id & user_id) use AND logic\n- Multiple values for same filter (e.g. workspace_id=123&workspace_id=456) use OR logic\n\nPagination:\n- Use starting_after with event IDs for cursor-based navigation\n- has_more indicates if more events exist beyond limit\n- total_count (optional) shows total matching events up to 100,000",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "dashboard",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "workspace_ids",
                  "value": "<uuid4>",
                  "description": "(Required) Filter by workspace IDs. Must contain at least one ID."
                },
                {
                  "disabled": false,
                  "key": "workspace_ids",
                  "value": "<uuid4>",
                  "description": "(Required) Filter by workspace IDs. Must contain at least one ID."
                },
                {
                  "disabled": false,
                  "key": "start_time",
                  "value": "<dateTime>",
                  "description": "(Required) Include events starting from this date (inclusive)"
                },
                {
                  "disabled": false,
                  "key": "end_time",
                  "value": "<dateTime>",
                  "description": "(Required) Include events until this date (exclusive)"
                },
                {
                  "disabled": false,
                  "key": "user_ids",
                  "value": "<string>",
                  "description": "Filter by user IDs"
                },
                {
                  "disabled": false,
                  "key": "user_ids",
                  "value": "<string>",
                  "description": "Filter by user IDs"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
